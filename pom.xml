<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>SampleCucumber</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>SampleCucumber</name>
    <url>https://github.com/plmlkrz/SampleCucumberTest</url>

    <dependencyManagement>
        <dependencies>
            <!-- ===== CVE REMEDIATIONS (transitive overrides) ===== -->

            <!-- jackson-core WS-2026-0003, CVE-2025-52999, WS-2022-0468
                 jackson-databind CVE-2022-42003, CVE-2022-42004
                 Also upgrade jackson-dataformat-yaml so it loads snakeyaml 2.x -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.18.3</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.18.3</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>2.18.3</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>2.18.3</version>
            </dependency>

            <!-- snakeyaml CVE-2022-1471, CVE-2022-25857, CVE-2022-38749/38750/38751/38752, CVE-2022-41854
                 jackson-dataformat-yaml 2.14+ supports snakeyaml 2.x -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>2.3</version>
            </dependency>

            <!-- gson CVE-2022-25647, WS-2021-0419 -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>2.11.0</version>
            </dependency>

            <!-- guava CVE-2023-2976, CVE-2020-8908 -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.4.0-jre</version>
            </dependency>

            <!-- okhttp CVE-2023-0833 — OkHttp 4.x Java API is backward-compatible with 3.x -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>4.12.0</version>
            </dependency>

            <!-- okio CVE-2023-3635 — fixed in 3.4.0+ -->
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio</artifactId>
                <version>3.9.0</version>
            </dependency>

            <!-- commons-beanutils CVE-2025-48734 -->
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>1.10.0</version>
            </dependency>

            <!-- commons-codec WS-2019-0379 -->
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>1.17.1</version>
            </dependency>

            <!-- commons-io CVE-2024-47554 -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.17.0</version>
            </dependency>

            <!-- webdrivermanager CVE-2025-4641 (XXE) -->
            <dependency>
                <groupId>io.github.bonigarcia</groupId>
                <artifactId>webdrivermanager</artifactId>
                <version>5.9.3</version>
            </dependency>

            <!-- commons-lang3 CVE-2025-48924 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.17.0</version>
            </dependency>

            <!-- log4j CVE-2021-44832, CVE-2021-45105, CVE-2025-68161 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>2.24.3</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>2.24.3</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-1.2-api</artifactId>
                <version>2.24.3</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j-impl</artifactId>
                <version>2.24.3</version>
            </dependency>

            <!-- org.json CVE-2022-45688, CVE-2023-5072, GHSA-rm7j-f5g5-27vv, WS-2017-3805 -->
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>20240303</version>
            </dependency>

            <!-- rhino CVE-2025-66453 -->
            <dependency>
                <groupId>org.mozilla</groupId>
                <artifactId>rhino</artifactId>
                <version>1.7.15</version>
            </dependency>

            <!-- Spring CVE-2022-22965, CVE-2025-41242, CVE-2022-22970, CVE-2025-41249,
                      CVE-2022-22968, CVE-2024-38820, CVE-2025-22233, CVE-2021-22060, CVE-2021-22096,
                      CVE-2023-20861, CVE-2022-22950, CVE-2023-20863, CVE-2024-38808 -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-beans</artifactId>
                <version>5.3.39</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-context</artifactId>
                <version>5.3.39</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-core</artifactId>
                <version>5.3.39</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-expression</artifactId>
                <version>5.3.39</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-aop</artifactId>
                <version>5.3.39</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-jcl</artifactId>
                <version>5.3.39</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Sentinel test automation framework (installed locally from https://github.com/plmlkrz/Sentinel) -->
        <dependency>
            <groupId>io.github.sentinel</groupId>
            <artifactId>sentinel</artifactId>
            <version>1.0.14-SNAPSHOT</version>
        </dependency>

        <!-- JUnit 5 Cucumber Platform Engine — replaces legacy JUnit 4 @RunWith runner -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>7.8.1</version>
        </dependency>

        <!-- @Suite annotation + suite discovery engine (aligns with Sentinel's junit-bom 5.9.2) -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>1.9.2</version>
        </dependency>

        <!-- Allows Surefire to use the JUnit Platform provider (not vintage JUnit 4) -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.9.2</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.10.1</version>
                    <configuration>
                        <release>21</release>
                        <!-- Disable annotation processing: this project has no Lombok annotations,
                             but Lombok 1.18.24 (transitive from Sentinel) crashes on Java 17+ -->
                        <proc>none</proc>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M8</version>
                <configuration>
                    <!-- Open java.io to allow Sentinel's ConfigurationData (extends File)
                         to be deserialized by Jackson on Java 17+ -->
                    <argLine>--add-opens java.base/java.io=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
